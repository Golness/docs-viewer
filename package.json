{
  "name": "@local/req-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "exports": {
    ".": "./src/server/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/client.js",
    "lib/client.*.js",
    "lib/client.js.map",
    "src/server/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "meta": {
    "title": "ReqHub - 需求中心",
    "description": "需求文档管理、AI分析、文档同步、需求追溯 - DeepSeek Harness 插件"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.1",
    "lightningcss": "^1.28.0",
    "oxc-resolver": "^11.24.2",
    "tsdown": "^0.23.1"
  }
}
