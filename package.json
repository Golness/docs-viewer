{
  "name": "@local/docs-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/server/index.js", "./client": "./src/client/index.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  },
  "meta": {
    "title": "Docs Viewer",
    "description": "Browse docs/*.md and docs/*.html for every workspace from the sidebar."
  }
}
